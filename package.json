{
  "name": "forge",
  "private": true,
  "version": "0.14.0",
  "description": "An AI workshop that drives code, 3D, PCB and chip tools from one conversation",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "vite build && cargo run --release -p forge-server",
    "dev": "cargo run -p forge-server & vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "cargo test --workspace",
    "desktop": "vite build && tauri dev",
    "desktop:build": "tauri build",
    "pcb-engine": "npm ci --prefix engines/pcb --no-audit --no-fund && npm run --prefix engines/pcb bundle"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "katex": "0.19.0",
    "marked": "18.1.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.0",
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
