{
  "name": "forge",
  "private": true,
  "version": "0.2.0",
  "description": "An AI workshop that drives code, 3D, PCB and chip tools from one conversation",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "vite build && node server/index.ts",
    "dev": "node --watch server/index.ts & vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
