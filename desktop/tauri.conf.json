{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forge",
  "mainBinaryName": "forge-desktop",
  "version": "../package.json",
  "identifier": "io.github.mdhaarith.forge",
  "build": {
    "frontendDist": "splash",
    "beforeBuildCommand": "sh scripts/stage-app.sh"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["rpm"],
    "category": "DeveloperTool",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "shortDescription": "AI workshop for code, 3D, PCB and circuit design",
    "longDescription": "Forge drives code, exact CAD, Blender, circuit boards and circuit simulation from one conversation, and keeps every project in git through its built-in Rust engine.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "resources": { "../build/app/": "app/" },
    "linux": {
      "rpm": {
        "recommends": ["blender", "python3-numpy", "librsvg2-tools", "kicad", "flatpak"]
      }
    }
  }
}
